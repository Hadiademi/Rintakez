NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to look up recipient emails for notification emails.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed site. Used for absolute links in emails and
# for sitemap / robots / canonical metadata. Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=https://framly.ch

# Optional — email notifications (Resend). With no RESEND_API_KEY the email
# feature is a no-op; in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM="Framly <noreply@framly.ch>"

# Optional — Google sign-in. Local only (production uses the Supabase dashboard).
# Set both, flip [auth.external.google] enabled=true in supabase/config.toml, restart Supabase.
GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional — observability. captureError() forwards errors here when set
# (Sentry/Logflare/Slack-style sink). Swap for @sentry/nextjs later if desired.
ERROR_WEBHOOK_URL=

# Optional — privacy-first analytics (Plausible, cookieless). Inert if unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Distributed rate limiting (Upstash Redis, REST). REQUIRED in production:
# without these the limiter falls back to an in-process Map that does NOT hold
# across serverless instances. Create a free Redis DB at upstash.com and paste
# its REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# REQUIRED — Vercel Cron auth shared secret (see vercel.json: */5 cron hitting
# /api/cron/process). Vercel sends `Authorization: Bearer <CRON_SECRET>` on
# cron-triggered requests when this is set. Without it the route 503s on every
# tick, so the durable email outbox and lifecycle-email scans (onboarding
# reminder, zero-bid rescue, review request, shoot-match digest) never run.
# Generate one with `openssl rand -hex 32`.
CRON_SECRET=

# Stripe billing (web-only, server-redirect Checkout + Customer Portal — no
# publishable key, no client-side Stripe SDK). Server secret key, from the
# Stripe dashboard (test key in dev). With this unset, getStripe() returns
# null and billing actions degrade gracefully (stripe_not_configured).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (`stripe listen` locally, or the
# dashboard endpoint's secret in prod). Without it the webhook route 503s.
STRIPE_WEBHOOK_SECRET=
# Price ids for each (plan, interval) pair, created in the Stripe dashboard.
# See the launch-day checklist in .superpowers/sdd/subs-P3-report.md.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
